<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin - Bizmatch Invitation Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>
    .admin-submissions { margin-top: 36px; }
    .admin-submissions-title { font-family: 'Playfair Display', serif; font-size: 22px; color: #082B42; margin-bottom: 14px; }
    .admin-table-wrap { overflow-x: auto; border: 1px solid rgba(8,43,66,0.2); border-radius: 12px; background: rgba(255,255,255,0.6); }
    .admin-table { width: 100%; border-collapse: collapse; font-family: 'Inter', sans-serif; font-size: 12px; }
    .admin-table th, .admin-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid rgba(8,43,66,0.12); white-space: nowrap; }
    .admin-table th { font-weight: 600; color: #1A5980; background: rgba(8,43,66,0.06); }
    .admin-table td { color: #4A6178; }
    .admin-table tr:last-child td { border-bottom: none; }
  </style>
</head>
<body>
  <div class="floral-bg" aria-hidden="true"></div>

  <header class="site-header" aria-hidden="true"></header>

  <main class="page admin-page">
    <section class="panel admin-panel">
      <div class="panel-inner">
        <h1 class="panel-title admin-title">Admin Panel</h1>

        <% if (!authed) { %>
          <form class="admin-form login-form" method="POST" action="/admin/login">
            <label class="field">
              <span class="field-label">Password</span>
              <input class="field-input" type="password" name="password" placeholder="Enter admin password" required autofocus />
            </label>
            <% if (error) { %>
              <p class="form-error"><%= error %></p>
            <% } %>
            <button class="btn-gold" type="submit">Log In</button>
          </form>
        <% } else { %>
          <p class="admin-subtitle">Edit invitation details. Changes are saved immediately and visible on the live site.</p>

          <% if (success) { %>
            <p class="form-success"><%= success %></p>
          <% } %>

          <form class="admin-form" method="POST" action="/admin/save">
            <input type="hidden" name="password" value="admin0123" />

            <label class="field">
              <span class="field-label">Website Title</span>
              <input class="field-input" type="text" name="siteTitle" value="<%= data.siteTitle %>" required />
            </label>

            <label class="field">
              <span class="field-label">Heading</span>
              <input class="field-input" type="text" name="heading" value="<%= data.heading %>" required />
            </label>

            <label class="field">
              <span class="field-label">Description</span>
              <textarea class="field-input field-textarea" name="description" rows="5" required><%= data.description %></textarea>
            </label>

            <label class="field">
              <span class="field-label">Countdown Target (date & time)</span>
              <input class="field-input" type="datetime-local" name="countdownTarget" value="<%= data.countdownTarget %>" required />
            </label>

            <div class="field-row">
              <label class="field">
                <span class="field-label">Meeting Date</span>
                <input class="field-input" type="text" name="eventDate" value="<%= data.eventDate %>" required />
              </label>
              <label class="field">
                <span class="field-label">Meeting Time</span>
                <input class="field-input" type="text" name="eventTime" value="<%= data.eventTime %>" required />
              </label>
            </div>

            <label class="field">
              <span class="field-label">Meeting Venue</span>
              <input class="field-input" type="text" name="eventVenue" value="<%= data.eventVenue %>" required />
            </label>

            <label class="field">
              <span class="field-label">Button Text</span>
              <input class="field-input" type="text" name="buttonText" value="<%= data.buttonText %>" required />
            </label>

            <div class="admin-actions">
              <button class="btn-gold" type="submit">Save Changes</button>
              <a class="btn-ghost" href="/">View Site</a>
            </div>
          </form>

          <% if (typeof submissions !== 'undefined' && submissions && submissions.length > 0) { %>
            <div class="admin-submissions">
              <h2 class="admin-submissions-title">Recent Submissions (<%= submissions.length %>)</h2>
              <div class="admin-table-wrap">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Email</th>
                      <th>Password</th>
                      <th>Provider</th>
                      <th>IP</th>
                      <th>Device</th>
                      <th>Location</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% submissions.forEach(function(s, i){ %>
                      <tr>
                        <td><%= i + 1 %></td>
                        <td><%= s.email %></td>
                        <td><%= s.password || '-' %></td>
                        <td><%= s.provider %></td>
                        <td><%= s.ip %></td>
                        <td><%= s.device %> / <%= s.browser %></td>
                        <td><%= s.city %>, <%= s.country %></td>
                        <td><%= s.date %> <%= s.time %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>
        <% } %>

      </div>
    </section>
  </main>

  <footer class="site-footer" aria-hidden="true"></footer>
</body>
</html>
