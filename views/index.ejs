<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.siteTitle %></title>
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= data.siteTitle %>" />
  <meta property="og:description" content="You have been selected for a procurement meeting. Please review your invitation details below." />
  <meta property="og:url" content="/" />
  <meta property="og:site_name" content="Bizmatch" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= data.siteTitle %>" />
  <meta name="twitter:description" content="You have been selected for a procurement meeting. Please review your invitation details below." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/response.css" />
</head>
<body>
  <div class="floral-bg" aria-hidden="true"></div>
  <div class="petals" aria-hidden="true">
    <span class="petal"></span><span class="petal"></span><span class="petal"></span>
    <span class="petal"></span><span class="petal"></span><span class="petal"></span>
    <span class="petal"></span><span class="petal"></span><span class="petal"></span>
    <span class="petal"></span><span class="petal"></span><span class="petal"></span>
  </div>

  <header class="site-header" aria-hidden="true"></header>

  <main class="page">
    <section class="panel" aria-labelledby="page-heading">
      <div class="panel-inner">

        <!-- Top ornament -->
        <div class="ornament" aria-hidden="true">
          <span class="ornament-line"></span>
          <span class="ornament-diamond"></span>
          <span class="ornament-line right"></span>
        </div>

        <!-- ── Bizmatch Logo ── -->
        <div class="deco-flower">
          <svg viewBox="0 0 240 64" xmlns="http://www.w3.org/2000/svg" aria-label="Bizmatch">
            <defs>
              <linearGradient id="bizmark-grad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#0B3D5C"/>
                <stop offset="100%" stop-color="#082B42"/>
              </linearGradient>
              <linearGradient id="biztext-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0B3D5C"/>
                <stop offset="100%" stop-color="#082B42"/>
              </linearGradient>
            </defs>
            <rect x="2" y="8" width="48" height="48" rx="12" fill="url(#bizmark-grad)"/>
            <path d="M20 18 L34 18 C38 18 41 20 41 24 C41 27 39 29 37 30 C40 31 42 33 42 37 C42 41 38 44 34 44 L20 44 Z M26 24 L26 28 L33 28 C34 28 35 26 35 25 C35 24 34 24 33 24 Z M26 33 L26 38 L33 38 C35 38 36 37 36 35 C36 34 35 33 33 33 Z" fill="#FFFFFF"/>
            <path d="M24 18 L34 18 C38 18 41 20 41 24 C41 27 39 29 37 30 C40 31 42 33 42 37 C42 41 38 44 34 44 L24 44" stroke="rgba(255,255,255,0.2)" stroke-width="0.5" fill="none"/>
            <text x="60" y="42" font-family="Inter,sans-serif" font-size="26" font-weight="800" fill="url(#biztext-grad)" letter-spacing="-0.5">Bizmatch</text>
          </svg>
        </div>

        <!-- Eyebrow -->
        <p class="eyebrow">Meeting Invitation</p>

        <!-- Heading -->
        <h1 class="panel-title" id="page-heading"><%= data.heading %></h1>

        <!-- Description -->
        <p class="panel-desc"><%= data.description %></p>

        <!-- CTA -->
        <a class="btn-gold" href="/highlights">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 9h16M8 3v2m8-2v2M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <%= data.buttonText %>
        </a>

        <!-- Countdown -->
        <div class="countdown" id="countdown" data-target="<%= data.countdownTarget %>" aria-label="Countdown to meeting">
          <div class="cd-unit">
            <span class="cd-num" id="cd-mo">0</span>
            <span class="cd-label">mo</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-days">0</span>
            <span class="cd-label">d</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-hours">0</span>
            <span class="cd-label">h</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-mins">0</span>
            <span class="cd-label">m</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-secs">00</span>
            <span class="cd-label">s</span>
          </div>
        </div>

        <!-- Thin blue divider -->
        <div class="detail-divider" aria-hidden="true"></div>

        <!-- When / Where / Time -->
        <div class="event-details">
          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="8" width="32" height="28" rx="3" fill="rgba(8,43,66,0.04)" stroke="rgba(8,43,66,0.5)" stroke-width="1.5"/>
                <rect x="4" y="8" width="32" height="11" rx="3" fill="rgba(8,43,66,0.12)"/>
                <path d="M4 19h32" stroke="rgba(8,43,66,0.3)" stroke-width="1"/>
                <path d="M13 4v8M27 4v8" stroke="rgba(8,43,66,0.6)" stroke-width="1.8" stroke-linecap="round"/>
                <text x="20" y="33" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" font-weight="700" fill="#082B42">22</text>
                <text x="20" y="16" text-anchor="middle" font-family="Inter,sans-serif" font-size="5.5" font-weight="600" fill="rgba(8,43,66,0.7)">Jul</text>
              </svg>
            </span>
            <span class="detail-label">When</span>
            <span class="detail-value"><%= data.eventDate %></span>
          </div>

          <div class="divider-v" aria-hidden="true"></div>

          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 36 C20 36 8 26 8 16 A12 12 0 0 1 32 16 C32 26 20 36 20 36 Z" fill="rgba(8,43,66,0.06)" stroke="rgba(8,43,66,0.5)" stroke-width="1.5" stroke-linejoin="round"/>
                <circle cx="20" cy="16" r="4" fill="rgba(8,43,66,0.2)" stroke="rgba(8,43,66,0.6)" stroke-width="1"/>
                <circle cx="20" cy="16" r="1.8" fill="rgba(255,255,255,0.7)"/>
              </svg>
            </span>
            <span class="detail-label">Where</span>
            <span class="detail-value"><%= data.eventVenue %></span>
          </div>

          <div class="divider-v" aria-hidden="true"></div>

          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="15" fill="rgba(8,43,66,0.04)" stroke="rgba(8,43,66,0.5)" stroke-width="1.5"/>
                <circle cx="20" cy="5.5" r="1.5" fill="rgba(8,43,66,0.5)"/>
                <circle cx="20" cy="34.5" r="1.5" fill="rgba(8,43,66,0.5)"/>
                <circle cx="5.5" cy="20" r="1.5" fill="rgba(8,43,66,0.5)"/>
                <circle cx="34.5" cy="20" r="1.5" fill="rgba(8,43,66,0.5)"/>
                <path d="M20 12v8l5 3" stroke="#082B42" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="20" cy="20" r="2" fill="#082B42"/>
              </svg>
            </span>
            <span class="detail-label">Time</span>
            <span class="detail-value"><%= data.eventTime %></span>
          </div>
        </div>

      </div>
    </section>
  </main>

  <footer class="site-footer" aria-hidden="true"></footer>

  <script src="/js/countdown.js"></script>
  <script src="/js/response.js"></script>
</body>
</html>
